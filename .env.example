# LLM 키. 제품(CLI · 앱)과 실험 도구(scripts/demo)가 같은 변수를 읽는다.
# 앱은 나중에 main/keys.ts 가 safeStorage 에서 읽어 process.env 에 올린다 (원칙 6 — 키는 사용자 PC 안에만).
PIECEPOOL_LLM_API_KEY=

# 제품 기본은 Kimi K3 (2026-09-15 합의 · 09-17 실측) — 비우면 아래 값이다. 실험 도구는 비우면 gemini-3.1-flash-lite (무료).
# PIECEPOOL_LLM_BASE_URL=https://api.moonshot.ai/v1
# PIECEPOOL_LLM_MODEL=kimi-k3
# PIECEPOOL_REASONING_EFFORT=low    # Kimi K3 만. low | high | max. 기본 low — high 는 비용 1.8배에 이득 없음
#
# Gemini 로 바꾸려면 (실험 도구의 옛 기본값):
# PIECEPOOL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PIECEPOOL_LLM_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY=                   # PIECEPOOL_LLM_API_KEY 가 비어 있으면 이것을 쓴다
# PIECEPOOL_EMBED_MODEL=gemini-embedding-001   # --embed 실험에만
