# 실험 도구(scripts/demo)용. 제품은 사용자 키를 앱 안에서 받는다 (원칙 6).
GEMINI_API_KEY=

# 다른 OpenAI 호환 공급자를 쓸 때 (예: Kimi). 비우면 Gemini.
# PIECEPOOL_LLM_BASE_URL=https://api.moonshot.ai/v1
# PIECEPOOL_LLM_MODEL=kimi-k3
# PIECEPOOL_LLM_API_KEY=            # 그 공급자의 키. 비우면 GEMINI_API_KEY 를 쓴다
# PIECEPOOL_REASONING_EFFORT=low    # Kimi 만. low | high | max. 기본 low — 출력 토큰이 비용의 대부분이다
# PIECEPOOL_EMBED_MODEL=gemini-embedding-001
